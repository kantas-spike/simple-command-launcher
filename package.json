{
  "name": "simple-command-launcher",
  "displayName": "simple-command-launcher",
  "description": "",
  "version": "0.0.7",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/kantas-spike/simple-command-launcher.git"
  },
  "license": "MIT",
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "simple-command-launcher.runCommand",
        "category": "Simple Command Launcher",
        "title": "Run"
      }
    ],
    "configuration": {
      "title": "Simple Command Launcher: run external command",
      "properties": {
        "simple-command-launcher.openCommand": {
          "type": "string",
          "title": "path of open command",
          "default": "/usr/bin/open"
        },
        "simple-command-launcher.vscodeCommand": {
          "type": "string",
          "title": "path of vscode command",
          "default": "/usr/local/bin/code"
        },
        "simple-command-launcher.defaultDelimiter": {
          "type": "string",
          "title": "default delimiter of command result",
          "description": "Default delimiter that splits each line of the command result (STDOUT) into `label` and `value` when `executionType` is `inputsForTasks`. Used when `delimiter` is not specified in the command.",
          "default": "|"
        },
        "simple-command-launcher.externalCommands": {
          "type": "array",
          "title": "External Commands",
          "description": "External commands merged across scopes. Items defined in workspace settings are added to the user settings list, and items with the same `name` override the ones from user settings (workspace folder > workspace > user).",
          "items": {
            "type": "object",
            "title": "External Command",
            "properties": {
              "name": {
                "type": "string",
                "description": "Name of Command"
              },
              "path": {
                "type": "string",
                "description": "Path of Command"
              },
              "executionType": {
                "type": "string",
                "description": "Type of Command",
                "default": "run",
                "enum": [
                  "run",
                  "pickAndCode",
                  "pickAndOpen",
                  "inputsForTasks"
                ],
                "enumDescriptions": [
                  "just run the command",
                  "select the command result and open it with `code`",
                  "select the command result and open it with `open`",
                  "select the command result (STDOUT) and return it as `inputs` of tasks.json"
                ]
              },
              "delimiter": {
                "type": "string",
                "description": "Delimiter that splits each line of the command result (STDOUT) into `label` and `value` when `executionType` is `inputsForTasks`. Defaults to the `defaultDelimiter` setting."
              },
              "args": {
                "type": "array",
                "title": "args",
                "items": {
                  "type": "object",
                  "title": "arg",
                  "properties": {
                    "name": {
                      "type": "string",
                      "description": "Name of Arg"
                    },
                    "value": {
                      "type": "string",
                      "description": "Value of Arg"
                    },
                    "useInput": {
                      "type": "boolean",
                      "description": "whether to use user input"
                    },
                    "choices": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "title": "choice",
                        "properties": {
                          "name": {
                            "type": "string",
                            "description": "Name of Choice"
                          },
                          "value": {
                            "type": "string",
                            "description": "Value of Choice"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js",
    "package": "npm run compile && npx vsce pack"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.2",
    "@types/node": "18.x",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.7.3",
    "@typescript-eslint/parser": "^6.7.3",
    "@vscode/test-electron": "^2.3.4",
    "@vscode/vsce": "^2.22.0",
    "eslint": "^8.50.0",
    "glob": "^10.3.3",
    "mocha": "^10.2.0",
    "typescript": "^5.2.2"
  }
}
